{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fillmein.local/schemas/fmi-export.schema.json",
  "title": "Eksport Fill Me In",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "exported_at",
    "project",
    "pages",
    "sections",
    "fields",
    "values",
    "assets",
    "missing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "format"
      ],
      "properties": {
        "name": {
          "const": "fill-me-in"
        },
        "format": {
          "const": "fmi-export"
        }
      }
    },
    "exported_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "slug"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_url",
        "uploaded_at"
      ],
      "description": "Schemat strony WordPress (fmi-site-schema), z którym zrobiono mapowanie. Brak — nazwy z Figmy.",
      "properties": {
        "site_url": {
          "type": "string",
          "minLength": 1
        },
        "uploaded_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "type": "string"
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/page"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/section"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/field"
      }
    },
    "values": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/value"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/asset"
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_empty",
        "unmapped"
      ],
      "properties": {
        "required_empty": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/requiredEmpty"
          }
        },
        "unmapped": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/unmapped"
          }
        }
      }
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nullableUuid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_id",
        "name",
        "slug",
        "position",
        "mapping"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "parent_id": {
          "$ref": "#/definitions/nullableUuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "post_type",
            "slug",
            "template"
          ],
          "properties": {
            "post_type": {
              "type": "string",
              "minLength": 1
            },
            "slug": {
              "type": "string"
            },
            "template": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "page_id",
        "name",
        "position",
        "hidden",
        "mapping"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "page_id": {
          "$ref": "#/definitions/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "hidden": {
          "type": "boolean"
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acf_block"
          ],
          "properties": {
            "acf_block": {
              "type": "string",
              "pattern": "^acf/[a-z0-9-]+$"
            },
            "occurrence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "client_note": {
          "type": "string"
        }
      }
    },
    "fieldType": {
      "enum": [
        "text",
        "textarea",
        "wysiwyg",
        "link",
        "image",
        "gallery",
        "group",
        "repeater"
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section_id",
        "parent_id",
        "key",
        "label",
        "type",
        "required",
        "hidden",
        "instructions",
        "position",
        "settings",
        "acf"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "section_id": {
          "$ref": "#/definitions/uuid"
        },
        "parent_id": {
          "$ref": "#/definitions/nullableUuid"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/fieldType"
        },
        "required": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "settings": {
          "type": "object"
        },
        "acf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type",
            "path",
            "mapped",
            "settings"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "mapped": {
              "type": "boolean"
            },
            "settings": {
              "type": "object"
            },
            "key": {
              "type": [
                "string",
                "null"
              ]
            },
            "transparent": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "textValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "field_type",
        "value"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "field_type": {
          "enum": [
            "text",
            "textarea",
            "wysiwyg"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "linkValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "field_type",
        "value"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "field_type": {
          "const": "link"
        },
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "imageValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "field_type",
        "value"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "field_type": {
          "const": "image"
        },
        "value": {
          "$ref": "#/definitions/nullableUuid"
        },
        "source_link": {
          "type": "string"
        }
      }
    },
    "galleryValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "field_type",
        "value"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "field_type": {
          "const": "gallery"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/uuid"
          }
        },
        "source_link": {
          "type": "string"
        }
      }
    },
    "repeaterValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "field_type",
        "value"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "field_type": {
          "const": "repeater"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/row"
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/value"
          }
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/definitions/textValue"
        },
        {
          "$ref": "#/definitions/linkValue"
        },
        {
          "$ref": "#/definitions/imageValue"
        },
        {
          "$ref": "#/definitions/galleryValue"
        },
        {
          "$ref": "#/definitions/repeaterValue"
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "mime",
        "width",
        "height",
        "size",
        "alt",
        "caption",
        "file_name",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "alt": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_name": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^(assets|media)/[0-9a-f]{64}\\.[a-z0-9]+$"
        }
      }
    },
    "requiredEmpty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "page",
        "section_id",
        "section",
        "field_id",
        "field",
        "reason"
      ],
      "properties": {
        "page_id": {
          "$ref": "#/definitions/uuid"
        },
        "page": {
          "type": "string"
        },
        "section_id": {
          "$ref": "#/definitions/uuid"
        },
        "section": {
          "type": "string"
        },
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "field": {
          "type": "string"
        },
        "row_id": {
          "$ref": "#/definitions/uuid"
        },
        "reason": {
          "enum": [
            "empty",
            "too_few",
            "missing_alt"
          ]
        }
      }
    },
    "unmapped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "page",
        "section_id",
        "section",
        "field_id",
        "field",
        "message"
      ],
      "properties": {
        "page_id": {
          "$ref": "#/definitions/uuid"
        },
        "page": {
          "type": "string"
        },
        "section_id": {
          "$ref": "#/definitions/uuid"
        },
        "section": {
          "type": "string"
        },
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "has_content": {
          "type": "boolean"
        }
      }
    }
  }
}
