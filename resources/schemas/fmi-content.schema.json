{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fillmein.ohsofresh.pl/schemas/fmi-content-2.json",
  "title": "Fill Me In — uniwersalny eksport treści (content.json)",
  "description": "Drzewo projekt → podstrony → sekcje → pola, niezależne od WordPressa i nazw bloków ACF. Dokumentacja: docs/export-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "generator",
    "exported_at",
    "scope",
    "project",
    "summary",
    "pages",
    "media",
    "missing"
  ],
  "properties": {
    "format": {
      "const": "fmi-content"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "const": "fill-me-in"
        }
      }
    },
    "exported_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "page_ids"
      ],
      "properties": {
        "type": {
          "enum": [
            "project",
            "pages"
          ]
        },
        "page_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/uuid"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "slug",
        "figma"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "figma": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "file_key"
          ],
          "properties": {
            "file_key": {
              "type": "string"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "sections",
        "fields",
        "filled",
        "empty",
        "cleared",
        "media",
        "media_links",
        "missing"
      ],
      "properties": {
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "sections": {
          "type": "integer",
          "minimum": 0
        },
        "fields": {
          "type": "integer",
          "minimum": 0
        },
        "filled": {
          "type": "integer",
          "minimum": 0
        },
        "empty": {
          "type": "integer",
          "minimum": 0
        },
        "cleared": {
          "type": "integer",
          "minimum": 0
        },
        "media": {
          "type": "integer",
          "minimum": 0
        },
        "media_links": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/page"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/media"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/missing"
      }
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "state": {
      "enum": [
        "filled",
        "empty",
        "cleared"
      ]
    },
    "mediaPath": {
      "type": "string",
      "pattern": "^media/[0-9a-f]{64}\\.[a-z0-9]+$"
    },
    "figmaNode": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_name"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "node_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "figmaField": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "node_id",
        "text"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mediaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id",
        "path"
      ],
      "properties": {
        "media_id": {
          "$ref": "#/definitions/uuid"
        },
        "path": {
          "$ref": "#/definitions/mediaPath"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_id",
        "name",
        "slug",
        "position",
        "figma",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "parent_id": {
          "oneOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "figma": {
          "$ref": "#/definitions/figmaNode"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/section"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "position",
        "hidden",
        "figma",
        "client_note",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "hidden": {
          "type": "boolean"
        },
        "figma": {
          "$ref": "#/definitions/figmaNode"
        },
        "client_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          }
        }
      }
    },
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "key",
            "label",
            "type",
            "required",
            "hidden",
            "instructions",
            "position",
            "settings",
            "figma",
            "state",
            "value"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/uuid"
            },
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "enum": [
                "text",
                "textarea",
                "wysiwyg"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "hidden": {
              "type": "boolean"
            },
            "instructions": {
              "type": [
                "string",
                "null"
              ]
            },
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "settings": {
              "type": "object"
            },
            "figma": {
              "$ref": "#/definitions/figmaField"
            },
            "state": {
              "$ref": "#/definitions/state"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "key",
            "label",
            "type",
            "required",
            "hidden",
            "instructions",
            "position",
            "settings",
            "figma",
            "state",
            "value"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/uuid"
            },
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "link"
            },
            "required": {
              "type": "boolean"
            },
            "hidden": {
              "type": "boolean"
            },
            "instructions": {
              "type": [
                "string",
                "null"
              ]
            },
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "settings": {
              "type": "object"
            },
            "figma": {
              "$ref": "#/definitions/figmaField"
            },
            "state": {
              "$ref": "#/definitions/state"
            },
            "value": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "key",
            "label",
            "type",
            "required",
            "hidden",
            "instructions",
            "position",
            "settings",
            "figma",
            "state",
            "value",
            "source_link"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/uuid"
            },
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "image"
            },
            "required": {
              "type": "boolean"
            },
            "hidden": {
              "type": "boolean"
            },
            "instructions": {
              "type": [
                "string",
                "null"
              ]
            },
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "settings": {
              "type": "object"
            },
            "figma": {
              "$ref": "#/definitions/figmaField"
            },
            "state": {
              "$ref": "#/definitions/state"
            },
            "value": {
              "oneOf": [
                {
                  "$ref": "#/definitions/mediaRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_link": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "key",
            "label",
            "type",
            "required",
            "hidden",
            "instructions",
            "position",
            "settings",
            "figma",
            "state",
            "value",
            "source_link"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/uuid"
            },
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "gallery"
            },
            "required": {
              "type": "boolean"
            },
            "hidden": {
              "type": "boolean"
            },
            "instructions": {
              "type": [
                "string",
                "null"
              ]
            },
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "settings": {
              "type": "object"
            },
            "figma": {
              "$ref": "#/definitions/figmaField"
            },
            "state": {
              "$ref": "#/definitions/state"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/mediaRef"
              }
            },
            "source_link": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "key",
            "label",
            "type",
            "required",
            "hidden",
            "instructions",
            "position",
            "settings",
            "figma",
            "state",
            "fields"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/uuid"
            },
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "group"
            },
            "required": {
              "type": "boolean"
            },
            "hidden": {
              "type": "boolean"
            },
            "instructions": {
              "type": [
                "string",
                "null"
              ]
            },
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "settings": {
              "type": "object"
            },
            "figma": {
              "$ref": "#/definitions/figmaField"
            },
            "state": {
              "$ref": "#/definitions/state"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/field"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "key",
            "label",
            "type",
            "required",
            "hidden",
            "instructions",
            "position",
            "settings",
            "figma",
            "state",
            "rows"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/uuid"
            },
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "const": "repeater"
            },
            "required": {
              "type": "boolean"
            },
            "hidden": {
              "type": "boolean"
            },
            "instructions": {
              "type": [
                "string",
                "null"
              ]
            },
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "settings": {
              "type": "object"
            },
            "figma": {
              "$ref": "#/definitions/figmaField"
            },
            "state": {
              "$ref": "#/definitions/state"
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/row"
              }
            }
          }
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "file_name",
        "mime",
        "size",
        "width",
        "height",
        "sha256",
        "alt",
        "caption"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "path": {
          "$ref": "#/definitions/mediaPath"
        },
        "file_name": {
          "type": "string"
        },
        "mime": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "alt": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "page",
        "section_id",
        "section",
        "field_id",
        "field",
        "reason"
      ],
      "properties": {
        "page_id": {
          "$ref": "#/definitions/uuid"
        },
        "page": {
          "type": "string"
        },
        "section_id": {
          "$ref": "#/definitions/uuid"
        },
        "section": {
          "type": "string"
        },
        "field_id": {
          "$ref": "#/definitions/uuid"
        },
        "field": {
          "type": "string"
        },
        "row_id": {
          "$ref": "#/definitions/uuid"
        },
        "reason": {
          "enum": [
            "empty",
            "too_few",
            "missing_alt"
          ]
        }
      }
    }
  }
}
